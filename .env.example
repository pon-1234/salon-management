# Database Configuration
DATABASE_URL="your-database-url"
DIRECT_URL="your-direct-database-url"
POSTGRES_URL="your-postgres-url"
POSTGRES_USER="your-postgres-user"
POSTGRES_HOST="your-postgres-host"
POSTGRES_PASSWORD="your-postgres-password"
POSTGRES_DATABASE="your-database-name"
POSTGRES_PRISMA_URL="your-prisma-url"
POSTGRES_URL_NON_POOLING="your-non-pooling-url"

# Legacy/development Supabase configuration (not used by the target VPS runtime)
SUPABASE_URL="your-supabase-url"
NEXT_PUBLIC_SUPABASE_URL="your-supabase-url"
SUPABASE_JWT_SECRET="your-jwt-secret"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
LINE_MESSAGING_CHANNEL_ACCESS_TOKEN="your-line-messaging-channel-access-token"
LINE_CHANNEL_SECRET="your-line-channel-secret"
LINE_MESSAGING_ENABLED=true
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# VPS local image storage (required by the target production runtime)
STORAGE_ROOT="/var/lib/salon-storage"
STORAGE_PUBLIC_BASE_URL="https://salon.example.com/salon-uploads"

# Notification providers (required in production)
RESEND_API_KEY="your-resend-api-key"
FROM_EMAIL="notifications@your-verified-domain.example"
VONAGE_API_KEY="your-vonage-api-key"
VONAGE_API_SECRET="your-vonage-api-secret"
VONAGE_SMS_FROM="Salon"
# Local/test-only. Production ignores this flag even when set to true.
NOTIFICATION_MOCK_ENABLED=false

# Cron Job Authentication
# Used to authenticate only explicitly approved cron endpoints.
# Generate with: openssl rand -hex 32
# Automatic point expiration remains disabled until FIFO lot reconciliation is complete.
CRON_SECRET="your-cron-secret-here"

# NextAuth Configuration
# Local example only. Production must use the public HTTPS origin and has no localhost fallback.
NEXTAUTH_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
# Generate a production value with: openssl rand -hex 32
NEXTAUTH_SECRET="replace-with-at-least-32-character-secret"

# Production must keep mock fallbacks disabled.
USE_MOCK_FALLBACK=false
NEXT_PUBLIC_USE_MOCK_FALLBACK=false

# Runtime safety mode. The production service uses live/provider.
APP_RUNTIME_MODE="live"
OUTBOUND_DELIVERY_MODE="provider"

# Preview/UAT deployment only:
# - set APP_RUNTIME_MODE="preview" and OUTBOUND_DELIVERY_MODE="disabled"
# - generate a unique token with `openssl rand -hex 32`; do not expose it to browsers
# - configure the authenticated upstream gateway to replace (not forward) the request header
#   `x-preview-access-gate-token` with this value for every route sent to Next.js
# PREVIEW_ACCESS_GATE_TOKEN="replace-with-a-unique-at-least-32-character-secret"
# Unique opaque marker also provisioned as the preview database `salon.target_id` setting.
# PREVIEW_TARGET_ID="replace-with-a-unique-preview-target-id"
# Optional, non-PII snapshot date or timezone-qualified timestamp shown in the UAT banner.
# PREVIEW_SNAPSHOT_CUTOFF="2026-07-20T12:00:00+09:00"
